{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Streamlit App",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/dml/app.py"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run Scraper",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/dml/01_get-results.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run Orchestrator",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/orchestrator/orchestrator.py",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
